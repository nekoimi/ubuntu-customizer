# Copy to config/local.env for local builds and fill in the chosen password.
# GitHub Actions uses the UBUNTU_INITIAL_PASSWORD repository Secret instead.
UBUNTU_INITIAL_PASSWORD=''

# Optional build-only HTTP proxy, e.g. the reachable v2rayA HTTP listener.
# HTTPS destinations also use an http:// URL (HTTP CONNECT), not a SOCKS port.
# Leave empty for direct access. Environment variables override this file.
HTTP_PROXY=''
HTTPS_PROXY=''
# Example for BOTH URLs: http://192.168.1.10:20171 (use your actual address/port).
# Prefer a reachable IP; host /etc/hosts entries are not inherited by chroots.
# Bypass domestic mirrors; set empty to proxy them too.
NO_PROXY='localhost,127.0.0.1,::1,.aliyun.com,.tsinghua.edu.cn'

# Optional runtime ntfy LAN-IP notifications. Set all three, or leave all empty.
# These values ARE embedded in the ISO. Keep the ISO private; use a publish-only token.
# Server base URL only (topic is separate). HTTPS is recommended for Bearer tokens.
NTFY_URL=''
NTFY_TOPIC=''
NTFY_TOKEN=''
